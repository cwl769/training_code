#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <algorithm>
#include <vector>

typedef long long i64;
typedef std::vector<int> veci;
typedef std::vector<i64> veci64;

char str[110];

void solve() {
    int n;
    scanf("%d", &n);
    scanf("%s", str + 1);
    int dif = 0;
    for (int i = 2; i <= n; ++i)
        if (str[i] != str[i - 1])
            ++dif;
    if (dif == 2)
        printf("2\n");
    else
        printf("1\n");
}

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
        solve();
    }

    return 0;
}
