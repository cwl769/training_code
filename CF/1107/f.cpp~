#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <algorithm>
#include <vector>

typedef long long i64;
typedef std::vector<int> veci;
typedef std::vector<i64> veci64;

char str[200010];

bool solve() {
    int n;
    scanf("%d", &n);
    scanf("%s", str + 1);
    int l = 1, r = n;
    while (l <= n && str[l] == '0')
        ++l;
    while (r >= 1 && str[r] == '1')
        --r;
    if (l >= r)
        return true;
    bool alleven = true;
    int last = l - 1;
    int cnt = 0;
    for (int i = l; i <= r; ++i) {
        ++cnt;
        if (i == r || str[i] != str[i + 1]) {
            if (cnt & 1) {
                alleven = false;
            }
            last = i;
            cnt = 0;
        }
    }
    if (alleven)
        return false;
    else
        return true;
}

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
        if (solve()) {
            printf("Alice\n");
        } else {
            printf("Bob\n");
        }
    }

    return 0;
}
