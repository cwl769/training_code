#include <algorithm>
#include <cstdio>
#include <vector>

void print(std::vector<int> &v) {
    for (auto x : v)
        printf("%d ", x);
    printf("\n");
}

int main() {
    int n = 9;
    std::vector<int> a(n);
    for (int i = 0; i < n; ++i) {
        a[i] = i;
    }
    do {
        std::vector<int> b = a;
        do {
            std::vector<int> c(n + 1);
            for (int i = 0; i < n; ++i) {
                int t = c[i] + b[i] + a[i];
                if (t >= n) {
                    ++c[i+1];
                    c[i] = t - n;
                } else {
                    c[i] = t;
                }
            }
            std::vector<bool> vis(n + n);
            for (int i = 0; i < n; ++i)
                vis[c[i]] = 1;
            bool pm = true;
            for (int i = 0; i < n; ++i) {
                if (!vis[i]) {
                    pm = false;
                    break;
                }
            }
            if (pm) {
                print(a);
                print(b);
                print(c);
                printf("-------------------\n");
            }
        } while(std::next_permutation(b.begin(), b.end()));
    } while(std::next_permutation(a.begin(), a.end()));


    return 0;
}
