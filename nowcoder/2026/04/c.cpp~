template<typename T>
void readInt(T& x) {
    static bool f;
    x = 0;f = false;
    char c = getchar();
    for(;c<'0' || c>'9';c=getchar())if(c=='-')f=!f;
    for(;'0'<=c&&c<='9';c=getchar()) {
        x = x * 10 + c - '0';
    }
    if(f)x = -x;
}
template<typename T, typename ...Args>
void readInt(T& x, Args&... args) {
    readInt(x);
    readInt(args...);
}

i64 d[20010][20];
char str[30];
i64 s[1 << 20][20];
i64 sm[20];
i64 dp[1<<20];

void solve() {
    int n, m;
    readInt(n, m);
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < m; ++j)
            readInt(d[i][j]);
        scanf("%s", str);
        int sta = 0;
        for (int j = 0; j < m; ++j) {
            if(str[j] == 'R')
                sta |= (1<<(j));
        }
        for (int j = 0; j < m; ++j) {
            s[sta][j] += d[i][j];
        }
    }
    for (int j = 0; j < m; ++j) {
        for (int i = 0; i < n; ++i)
            sm[j] += d[i][j];
    }

    int cov = (1 << m);
    for (int j = 0; j < m; ++j) {
        for (int i = 0; i < m; ++i) {
            for (int sta = 0; sta < cov; ++sta) {
                if (sta & (1 << i)) {
                    s[sta][j] += s[sta ^ (1 << i)][j];
                }
            }
        }
    }
    
    memset(dp, 0x3f, sizeof(dp));
    dp[0] = 0;
    for (int sta = 0; sta < cov; ++sta) {
        for (int i = 0; i < m; ++i) {
            if ((sta >> i) & 1)
                continue;
            int rev = ((~sta) & (cov - 1));
            int tar = (sta | (1 << i));
            dp[tar] = std::min(dp[tar], dp[sta] + s[rev][i]);
        }
    }
    printf("%lld\n", dp[cov-1]);
}

